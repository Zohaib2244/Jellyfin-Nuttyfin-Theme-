# Production: Nuttyfin is the default document on the existing Jellyfin hostnames.
# Keep this snippet before the site block that imports it.
# The original Jellyfin web client and all native API paths still proxy to Jellyfin.
(nuttyfin_site) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# ── helper service (NutBot, On TV calendar, smart delete) ──
	# Slow on purpose: a NutBot turn can take 30 s and a real delete can take a couple of minutes.
	handle /nutfin-api/* {
		reverse_proxy 192.168.1.24:8120 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 150s
				read_timeout 150s
				write_timeout 150s
			}
		}
	}

	# ── Jellyfin (video, images, API, websocket) ──
	# handle_path strips /jf, so Jellyfin sees its normal paths and needs no "base URL" setting.
	# Caddy upgrades websockets by itself (the SPA's /jf/socket). flush_interval -1 = never buffer video or events.
	# No overall timeout: a movie is a long response. Only the connect and first-byte waits are bounded.
	handle_path /jf/* {
		reverse_proxy 192.168.1.24:8096 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}

	# ── Seerr (requests) ──
	# Seerr sets its session cookie as "connect.sid; Path=/". Under a prefix that would send the Seerr cookie to
	# /jf/* and /nutfin-api/* as well, so the path is narrowed to /seerr (see deploy/README.md, "Seerr behind /seerr").
	handle_path /seerr/* {
		reverse_proxy 192.168.1.24:5055 {
			header_down Set-Cookie "(?i)Path=/(;|$)" "Path=/seerr$1"
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# ── the app itself ──
	# Hashed build files never change under the same name: cache them for a year. A missing one must be a real 404
	# (never index.html with a year-long cache).
	handle /assets/* {
		root * /data/nuttyfin/current
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, favicon, #/routes) is revalidated every time, so a new deploy shows up on the next load.
	# Nuttyfin uses hash routes; only its document and favicon replace Jellyfin's UI.
	@nuttyfin_document path / /index.html /favicon.svg
	handle @nuttyfin_document {
		root * /data/nuttyfin/current
		header Cache-Control "no-cache"
		file_server
	}
	# Preserve Jellyfin's original /web/ interface and all native-client API endpoints.
	handle {
		reverse_proxy 192.168.1.24:8096 {
			flush_interval -1
		}
	}
}


http://jellyfin.avns.nut, http://jellyfin.avns.site {
	import nuttyfin_site
}
