# Nuttyfin helper service: configuration TEMPLATE. Copy to a file OUTSIDE the repo (for example
# /etc/nuttyfin-helper.env, mode 600, owned by the service user) and fill it in. Never commit the real file.
# Every key is read from the environment; systemd loads this file with EnvironmentFile=.

# ── where it listens ──
# Caddy runs in Docker and reaches the host through the LAN address, so bind to it (not 0.0.0.0, not the public side).
NUTFIN_HELPER_HOST=192.168.1.24
NUTFIN_HELPER_PORT=8120

# ── upstreams (the helper talks to these from the host) ──
NUTFIN_JELLYFIN_URL=http://192.168.1.24:8096
NUTFIN_SEERR_URL=http://192.168.1.24:5055
NUTFIN_SONARR_URL=http://192.168.1.24:8989
NUTFIN_RADARR_URL=http://192.168.1.24:7878
NUTFIN_QBT_URL=http://192.168.1.24:8080

# API keys: Sonarr/Radarr = Settings > General > API key (also in <app>/config/config.xml).
# Seerr = Settings > General > API key (only used to check that a NutBot "request" pick really exists).
NUTFIN_SONARR_KEY=
NUTFIN_RADARR_KEY=
NUTFIN_SEERR_KEY=
# qBittorrent Web UI login. Leave both empty if qBittorrent bypasses auth for this address.
NUTFIN_QBT_USER=
NUTFIN_QBT_PASS=

# qBittorrent / Radarr / Sonarr run in containers and see the media drive as /media; the helper runs on the host.
# "container path=host path" pairs, comma separated. Needed to measure hardlinks for the smart delete plan.
NUTFIN_PATH_MAPS=/media=/mnt/nuttyfin/Nuttyfin

# ── smart delete ──
# The helper REFUSES real deletes unless this is exactly 1. Dry runs and plans always work without it.
NUTFIN_ALLOW_DELETE=0

# ── NutBot brain ──
# Which CLI to shell out to: claude or codex. NUTFIN_CLI_PATH overrides the binary (default: look it up on PATH).
NUTFIN_CLI=claude
NUTFIN_CLI_PATH=
# Optional model name passed through as --model (claude) / --model (codex). Empty = the CLI default.
NUTFIN_CLI_MODEL=
# Optional: a CLAUDE_CONFIG_DIR for the child process, so NutBot does not load the server's own CLAUDE.md / memory.
# Put only the CLI's login in that folder.
NUTFIN_CLI_CONFIG_DIR=
NUTFIN_CLI_TIMEOUT_MS=30000
# Per person: chats per minute, and the biggest prompt (characters) that is ever sent to the CLI.
NUTFIN_CHAT_PER_MIN=6
NUTFIN_MAX_PROMPT_CHARS=14000
# How many library titles go into the digest NutBot sees.
NUTFIN_DIGEST_MAX=400
